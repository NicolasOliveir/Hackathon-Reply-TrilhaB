{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reply.local/contracts/v1/qa-test-plan.schema.json",
  "title": "QaTestPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "story_id", "story_hash", "revision",
    "delivery_manifest_hash", "criteria", "cases", "test_artifacts", "environment"
  ],
  "properties": {
    "contract_version": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/contractVersion"},
    "run_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "story_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/storyId"},
    "story_hash": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 1},
    "delivery_manifest_hash": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "order", "description"],
        "properties": {
          "criterion_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/criterionId"},
          "order": {"type": "integer", "minimum": 1},
          "description": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/nonEmptyText"}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "criterion_id", "gate", "title", "test_type", "execution", "expected", "evidence_types", "required"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3,}$"},
          "criterion_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/criterionId"},
          "gate": {"type": "string", "pattern": "^G[0-9]$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "test_type": {"type": "string", "enum": ["unit", "integration", "contract", "api", "browser", "mobile", "accessibility", "security"]},
          "execution": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/executionSpec"},
          "expected": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/nonEmptyText"},
          "evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["stdout", "junit", "coverage", "screenshot", "trace", "axe", "audit"]}},
          "required": {"type": "boolean"}
        }
      }
    },
    "test_artifacts": {"type": "array", "items": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/artifactRef"}},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["rebuild_on_manifest_change", "manifest_paths", "runner_profile"],
      "properties": {
        "rebuild_on_manifest_change": {"type": "boolean"},
        "manifest_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "runner_profile": {"type": "string", "enum": ["python", "node", "fullstack", "generic"]}
      }
    }
  }
}
