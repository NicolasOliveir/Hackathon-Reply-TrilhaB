{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reply.local/contracts/v1/runner-result.schema.json",
  "title": "RunnerResult",
  "description": "Observed execution results only. The control API derives the verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "story_id", "story_hash", "revision",
    "delivery_manifest_hash", "test_plan_hash", "environment_status",
    "overall_exit_code", "results", "artifacts"
  ],
  "properties": {
    "contract_version": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/contractVersion"},
    "run_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "story_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/storyId"},
    "story_hash": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 1},
    "delivery_manifest_hash": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "test_plan_hash": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "environment_status": {"type": "string", "enum": ["READY", "FAILED"]},
    "overall_exit_code": {"type": ["integer", "null"]},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "criterion_id", "status", "exit_code", "duration_ms", "evidence_refs"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3,}$"},
          "criterion_id": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/criterionId"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "ERROR", "TIMEOUT", "SKIPPED"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "evidence_refs": {"type": "array", "items": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/uuid"}}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "https://reply.local/contracts/v1/common.schema.json#/$defs/artifactRef"}}
  }
}
