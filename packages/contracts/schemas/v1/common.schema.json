{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reply.local/contracts/v1/common.schema.json",
  "title": "Common contract definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runState": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "WORKER_QUEUED",
        "WORKER_RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELED"
      ]
    },
    "taskState": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELED"
      ]
    },
    "agentRole": {
      "type": "string",
      "enum": ["fake", "po", "dev", "qa", "runner"]
    },
    "eventActor": {
      "type": "string",
      "enum": ["system", "fake_worker", "po", "dev", "qa", "runner"]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "RUN_CREATED",
        "BRIEFING_RECEIVED",
        "TASK_QUEUED",
        "AGENT_STARTED",
        "FAKE_WORKER_COMPLETED",
        "STORY_FROZEN",
        "PO_COMPLETED",
        "DEV_TASK_PLAN_CREATED",
        "ADR_RECORDED",
        "TOOL_EXECUTED",
        "CODE_DELIVERED",
        "CODE_REDELIVERED",
        "TEST_PLAN_CREATED",
        "TEST_EXECUTED",
        "FINDING_RECORDED",
        "STORY_ACCEPTED",
        "STORY_REJECTED",
        "NEEDS_HUMAN",
        "AGENT_FAILED",
        "RUN_COMPLETED",
        "RUN_FAILED",
        "RUN_CANCELED"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "context:read",
        "model:invoke",
        "output:write",
        "heartbeat:write",
        "artifact:write"
      ]
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "storyId": {
      "type": "string",
      "pattern": "^STORY-[0-9]{3,}$"
    },
    "criterionId": {
      "type": "string",
      "pattern": "^AC-[0-9]{3,}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "uri", "media_type", "size_bytes", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 80},
        "uri": {"$ref": "#/$defs/uri"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 120},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
